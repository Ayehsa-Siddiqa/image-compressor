# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Without these the site uses the built-in blog posts and /dashboard explains how to set up.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SEO (optional). Your live address, e.g. https://toolve.com. On Vercel the production address is used if empty.
NEXT_PUBLIC_SITE_URL=
# Verification codes from Google Search Console and Bing Webmaster Tools ("HTML tag" method: only the content value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
