# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Without these the site uses the built-in blog posts and /dashboard explains how to set up.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
